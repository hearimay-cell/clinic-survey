# ==============================================================================
# [한의원 무상태 설문 중계 시스템] 환경변수 설정 파일 (.env)
# ==============================================================================

# 1. Supabase Project URL (예: https://abcdefghijklm.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase anon public Key (예: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...)
SUPABASE_ANON_KEY=your-anon-public-key

# 3. 최종 설문 결과(.html, .json, .csv)를 저장할 원내 로컬 폴더 경로
#    (원내 공유폴더 예: \\ClinicPC\공유폴더\설문결과 또는 원드라이브 폴더 경로)
#    원내 Streamlit 대시보드 화면 좌측 사이드바에서도 언제든지 변경/저장할 수 있습니다.
LOCAL_SAVE_DIR=D:\hotmail\OneDrive\AI관련\research\survey_data

# 4. 환자용 모바일 웹 배포 주소 (Cloudflare Pages 배포 후 주소 입력, 카톡 링크 생성기에 사용)
PATIENT_WEB_URL=https://your-clinic-survey.pages.dev

